{
  "schema_version": 2,
  "repository": "Ali1/cakephp-bruteforce",
  "categories": {
    "phpunit": {
      "reusable": true,
      "local_check": "phpunit",
      "scope": {
        "platform": "windows-native",
        "runtime": "php-8.4",
        "database": "none",
        "kind": "unit"
      },
      "inputs": [
        ".github/local-certification-v2.json",
        ".github/local-checks.json",
        "bin/certify-local.ps1",
        "bin/certify-local-v2.ps1",
        "composer.json",
        ".github/local-test-composer.lock",
        ".github/scripts/prepare-native-dependencies.php",
        "phpunit.xml.dist"
      ]
    },
    "phpstan": {
      "reusable": true,
      "local_check": "phpstan",
      "scope": {
        "platform": "portable-static",
        "runtime": "php-8.4",
        "database": "none",
        "kind": "static"
      },
      "inputs": [
        ".github/local-certification-v2.json",
        ".github/local-checks.json",
        "bin/certify-local.ps1",
        "bin/certify-local-v2.ps1",
        "composer.json",
        ".github/local-test-composer.lock",
        ".github/scripts/prepare-native-dependencies.php",
        "phpunit.xml.dist"
      ]
    }
  },
  "unmapped_coverage": "All categories not explicitly declared reusable remain required on their real platform/runtime/database; no whole-application certificate is inferred."
}
